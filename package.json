{
  "name": "fleetless-app-starter",
  "private": true,
  "type": "module",
  "description": "A template app on @fleetless/sdk: every screen an app user can reach, on the Nuxt UI dashboard.",
  "license": "MIT",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fleetless/sdk": "3.1.1",
    "@iconify-json/lucide": "^1.2.131",
    "@nuxt/ui": "^4.11.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "livekit-client": "^2.21.0",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32",
    "vue": "^3.5.42",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.10.0",
    "happy-dom": "^20.11.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.4.1"
}
