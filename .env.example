# The Fleetless cloud this app talks to. The dev stack is :8080; production is https://api.fleetless.dev
NUXT_PUBLIC_API_URL=http://localhost:8080
# The app's identifier, shown in the console on the app's page.
NUXT_PUBLIC_APP_IDENTIFIER=
# Hostnames `nuxt dev` may answer to, comma-separated. Empty is right unless you
# reach the dev server by DNS name: localhost and every IP already work.
NUXT_DEV_ALLOWED_HOSTS=
